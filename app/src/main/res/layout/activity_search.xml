<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Recherche Simple -->
            <EditText
                android:id="@+id/et_search_simple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Recherche rapide..."
                android:inputType="text" />

            <!-- Bouton pour afficher/masquer la recherche avancée -->
            <TextView
                android:id="@+id/tv_toggle_advanced_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recherche avancée"
                android:textColor="?attr/colorPrimary"
                android:layout_gravity="end"
                android:padding="8dp" />

            <!-- Section Recherche Avancée (masquée par défaut) -->
            <LinearLayout
                android:id="@+id/advanced_search_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search_titre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Titre" />

                <EditText
                    android:id="@+id/et_search_univers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Univers / Série" />

                <EditText
                    android:id="@+id/et_search_editeur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Fabricant" />

                <EditText
                    android:id="@+id/et_search_annee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Année"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/et_search_categorie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Catégorie" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/search_button" />

        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>