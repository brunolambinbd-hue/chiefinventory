<resources>
    <!-- Thème de base pour le mode nuit, SANS barre d'action -->
    <style name="Theme.ParaBDCollector" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Couleurs de marque primaires pour le mode nuit -->
        <item name="colorPrimary">@color/colorPrimary</item> <!-- On garde la même couleur primaire -->
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        
        <!-- Couleurs de marque secondaires pour le mode nuit -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- Couleurs d'erreur personnalisées -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        
        <!-- Couleur de la barre de statut -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
